# Request
uint32  index              # chunk number in original JSON
string  prompt             # "What do you think the puppy feels?"
string  context_before     # narrative sentences that preceded
string  context_after      # sentences that follow (optional)
string  target_vocab       # target vocabulary (optional)
string  type               # interaction type (e.g., "scaffolding", "other")
uint32  depth              # max depth for this interaction
---
# Response
bool    success           # true if interaction completed successfully
string  final_reply       # the last utterance delivered by the robot
